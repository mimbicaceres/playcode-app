{
  "name": "codix-server",
  "description": "Backend API de CODIX - Plataforma de aprendizaje de programación",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx src/prisma/seed.ts",
    "db:seed:python": "tsx prisma/seed-python-course.ts",
    "verify:js-course": "tsx scripts/verifyJsCourse.ts",
    "verify:sql-course": "tsx scripts/verifySqlCourse.ts",
    "verify:html-course": "tsx scripts/verifyHtmlCourse.ts",
    "db:catalog": "tsx scripts/populateCatalog.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "bcrypt@6.0.0": true
  }
}
