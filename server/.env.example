# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/codix_db"

# JWT
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-64-chars"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=4000
NODE_ENV=development

# Seed (solo desarrollo): contraseña de las cuentas fijas de prueba.
# Si no se define, `npm run db:seed` solo crea las cuentas demo.
SEED_TEST_PASSWORD=""
