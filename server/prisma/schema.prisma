generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum ExerciseType {
  fill_variable
  code_runner
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  lastName     String
  role         UserRole @default(student)
  school       String?
  grade        String?
  avatarUrl    String?
  streakDays   Int      @default(0)
  // Ultima vez que el usuario intento un ejercicio (exito o no). Se usa para
  // calcular la racha con huso horario de Argentina, independiente de
  // updatedAt (que cambia con cualquier edicion del perfil).
  lastActivityAt DateTime?
  totalXp      Int      @default(0)
  // Deactivated accounts cannot sign in (set by an admin).
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseAssignments CourseAssignment[]
  // New relation for exercise progress
  exerciseProgresses ExerciseProgress[]
  // Historial de intentos (cada vez que el alumno ejecuta y verifica su codigo).
  exerciseAttempts   ExerciseAttempt[]
}

// Datos generales del instituto (un solo registro global: esta plataforma
// no modela multiples instituciones, solo un instituto usandola).
model Institute {
  id           String   @id @default("singleton")
  name         String?
  address      String?
  contactEmail String?
  // Ajustes de gamificacion (los configura el admin en Configuracion):
  // XP otorgado = (rewardXp del ejercicio + baseXp) x xpMultiplier, y ademas
  // streakBonusXp la primera vez que el alumno completa un ejercicio en el dia.
  xpMultiplier   Float    @default(1)
  baseXp         Int      @default(0)
  streakBonusXp  Int      @default(0)
  // Ids de logros desactivados (no se muestran ni se desbloquean).
  disabledBadges String[] @default([])
  updatedAt    DateTime @updatedAt
}

model Course {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String?
  description String?
  // Lenguaje del curso (python | javascript | sql | html): define el ejecutor,
  // la categoria que ve el alumno y el lenguaje por defecto de sus ejercicios.
  language    String   @default("python")
  // Opciones para identificar y presentar el curso (todas opcionales):
  // categoria libre (p. ej. "Java"), nivel, duracion estimada, icono (nombre de Material
  // Symbols) y color (#RRGGBB). Sin ellas se usan las del lenguaje.
  category       String?
  level          String?
  estimatedHours Int?
  iconName       String?
  color          String?

  units       Unit[]
  assignments CourseAssignment[]
  progresses ExerciseProgress[]
}

model Unit {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String?
  order     Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  exercises Exercise[]
  progresses ExerciseProgress[]

}

model Exercise {
  id          String       @id @default(uuid())
  slug        String?
  title       String?
  type        ExerciseType @default(fill_variable)
  order       Int          @default(0)
  // Consigna del ejercicio (solo para type = code_runner).
  prompt      String?
  starterCode String?
  language    String       @default("python")
  rewardXp    Int          @default(0)
  hint        String?
  unit        Unit         @relation(fields: [unitId], references: [id])
  unitId      String
  testCases   TestCase[]
}

model TestCase {
  id             String   @id @default(uuid())
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId     String
  order          Int      @default(0)
  // stdin que recibe el programa del alumno.
  input          String?
  expectedOutput String
  // Casos ocultos: se usan para corregir pero nunca se muestran al alumno.
  isHidden       Boolean  @default(false)
  // Como se compara la salida que reporta el navegador con expectedOutput:
  // "text" (stdout, default), "rows_ordered" / "rows_unordered" (SQL: JSON con
  // columnas y filas) o "dom" (HTML/CSS: JSON con las mediciones del DOM).
  compareMode    String   @default("text")
  // Datos que necesita el runner (p. ej. el script SQL de la base de ejemplo o
  // que selectores medir). Nunca incluye la respuesta esperada.
  spec           Json?

  @@index([exerciseId])
}

// Course of the CODIX catalog assigned by an admin to a student or a teacher.
// Courses are predefined by CODIX (not stored here): courseId is the catalog id.
model CourseAssignment {
  id        String @id @default(cuid())
  userId    String
  // slug reference (original) – keep for backward compatibility
  courseId  String
  createdAt DateTime @default(now())

  // Real FK to Course record
  course   Course @relation(fields: [courseId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// ----------------------------------------------------
// PROGRESO DE EJERCICIOS (solo datos que se guardan)
// ----------------------------------------------------
model ExerciseProgress {
  id          String   @id @default(cuid())

  // Relación al usuario que realiza el ejercicio – mismo tipo que User.id (String)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  // Identificador del ejercicio tal como está en el catálogo (src/data/codixCatalog.ts)
  exerciseId  String

  // Opcionales – se guardan para facilitar consultas y filtros
  // slug references (original)
  unitId   String?   // p.e. "unit-3"
  courseId String?   // p.e. "prog1"

  unit   Unit?   @relation(fields: [unitId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])
  // Estadísticas
  attempts    Int       @default(0)      // cuántas veces se intentó
  completed   Boolean   @default(false)  // true la primera vez que se pasa
  xpEarned    Int       @default(0)      // XP ganado en esa primera pasada

  // Tiempos
  lastAttempt DateTime?                 // último intento (independiente de éxito)
  completedAt DateTime?                 // when the exercise was first completed

  // Índices y unicidad
  @@unique([userId, exerciseId])               // un solo registro por usuario‑ejercicio
  @@index([courseId, unitId])                  // búsquedas por curso / unidad
}

// ----------------------------------------------------
// HISTORIAL DE INTENTOS
// ----------------------------------------------------
// Una fila por cada vez que el alumno verifica su codigo (acierte o no). De aca
// salen la precision, la actividad reciente, el tiempo de practica y las
// areas que requieren atencion. ExerciseProgress sigue siendo el resumen por
// ejercicio (intentos, completado, XP).
model ExerciseAttempt {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  exerciseId  String
  unitId      String?
  courseId    String?
  success     Boolean
  // Tiempo activo (en segundos) que el alumno estuvo en el ejercicio hasta este
  // intento, informado por el navegador. Null = sin dato (se estima).
  durationSec Int?
  // Lineas no vacias del codigo enviado.
  lines       Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([courseId, unitId])
}
